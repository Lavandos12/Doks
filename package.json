{
  "name": "doks-root",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "shared",
    "agent",
    "web",
    "tests"
  ],
  "scripts": {
    "build": "npm run build --workspace=shared && npm run build --workspace=web && npm run build --workspace=agent",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "dev:agent": "npm run dev --workspace=agent",
    "dev:web": "npm run dev --workspace=web"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
