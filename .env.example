# Doks Collaborative Workspace - Environment Configuration

# Server Binding & Port
PORT=4780
DOKS_HOST=0.0.0.0
NODE_ENV=production

# Storage Path (used by Northflank persistent volumes / Docker)
DOKS_DATA_DIR=/app/data

# Optional workspace protection password
WORKSPACE_PASSWORD=

# Optional: Cloudflare R2 / AWS S3 Object Storage (Enables 24/7 persistence on Render Free Tier)
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET=doks-vault
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_REGION=auto
