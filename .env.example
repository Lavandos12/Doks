# Doks Collaborative Workspace - Environment Configuration

# Application port (dynamically detected from process.env.PORT on Railway and Render)
PORT=4780

# Network host binding (0.0.0.0 for cloud/Docker, 127.0.0.1 for local loopback)
DOKS_HOST=0.0.0.0

# Vault storage directory for notes, canvas files, and media
DOKS_DATA_DIR=./data

# Optional workspace protection password
WORKSPACE_PASSWORD=
